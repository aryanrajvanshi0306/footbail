# ─── footbAIl Backend — Environment Variables ────────────────────────────────
# Copy: cp .env.example .env
# All vars have sensible defaults for local development.

# ── App ──────────────────────────────────────────────────────────────────────
ENV=development
LOCAL_DEV=true
SECRET_KEY=local-dev-secret-change-in-prod-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Origins allowed for CORS (JSON list)
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","https://app.footbail.in"]

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://footbail:footbail@localhost:5432/footbail

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── AWS / LocalStack ─────────────────────────────────────────────────────────
# For local dev, these point to LocalStack. No real AWS account needed.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Set this to http://localhost:4566 for local dev (empty = real AWS)
AWS_ENDPOINT_URL=http://localhost:4566

# S3 buckets (created automatically by LocalStack init script)
RAW_VIDEO_BUCKET=footbail-raw-videos
PROCESSED_VIDEO_BUCKET=footbail-processed-videos

# ── Cognito (leave blank for local dev — uses local JWT) ─────────────────────
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_DOMAIN=

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Feature Flags ─────────────────────────────────────────────────────────────
# DEV_OTP_BYPASS=true → any 6-digit OTP works (NEVER true in production)
DEV_OTP_BYPASS=true
SNS_SENDER_ID=footbAIl

# ── Production overrides (fill in when deploying to AWS) ─────────────────────
# AWS_ACCESS_KEY_ID=<real key>
# AWS_SECRET_ACCESS_KEY=<real secret>
# AWS_ENDPOINT_URL=          ← empty means real AWS
# COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXX
# COGNITO_APP_CLIENT_ID=26fjXXXXXXXX
# COGNITO_DOMAIN=footbail.auth.ap-south-1.amazoncognito.com
# DEV_OTP_BYPASS=false
